# Host-based development against the Compose dependency stack.
#
# Compose publishes PostgreSQL, Redis and MinIO on shifted host ports so they do not
# collide with locally installed services. Use this file when running `pnpm dev`
# outside containers; `.env.example` documents the in-container values.
#
#   cp .env.local.example .env.local
#   pnpm compose:up          # dependencies
#   set -a && . ./.env.local && set +a && pnpm dev

NODE_ENV=development
QP_ENVIRONMENT=development

DATABASE_URL=postgresql://quantum_parks:local-development-only@localhost:15432/quantum_parks
REDIS_URL=redis://localhost:16379

TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=quantum-parks-post-call

S3_ENDPOINT=http://localhost:19000
S3_REGION=eu-west-1
S3_BUCKET_RAW=qp-raw-evidence
S3_BUCKET_ASSETS=qp-assets
S3_ACCESS_KEY=quantum-parks-local
S3_SECRET_KEY=quantum-parks-local-secret

OIDC_ISSUER=http://localhost:8080/realms/quantum-parks
OIDC_CLIENT_ID=quantum-parks-admin
OIDC_AUDIENCE=quantum-parks-api
OIDC_CLIENT_SECRET_REF=local/oidc/client

ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_SANDBOX_BASE_URL=http://localhost:4100
ELEVENLABS_SECRET_REF=local/elevenlabs/api-key
ELEVENLABS_WEBHOOK_SECRET_REF=local/elevenlabs/webhook
ELEVENLABS_WORKSPACE_ID=workspace_synthetic
ELEVENLABS_CAPABILITY_MODE=simulator

PROVIDER_CREDENTIAL_MASTER_KEY=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PROVIDER_CREDENTIAL_KEY_VERSION=v1

AIOS_INTERNAL_URL=http://localhost:4000
AIOS_SERVICE_TOKEN=local-development-only

TWILIO_ACCOUNT_SECRET_REF=local/twilio/account
TWILIO_WEBHOOK_SECRET_REF=local/twilio/webhook

AUDIO_INGESTION_ENABLED=false
CUSTOM_VOICE_ENABLED=false
BOOKING_WRITES_ENABLED=false
PRODUCTION_RETENTION_APPROVED=false
PROVIDER_PRIVACY_APPROVED=false
CALLER_DISCLOSURE_APPROVED=false
NATIVE_LANGUAGE_APPROVALS=

LOCAL_ELEVENLABS_API_KEY=sk_local_development_only_0000000000
LOCAL_ELEVENLABS_WEBHOOK_SECRET=whsec_local_development_only
LOCAL_TOOL_TOKEN=local-development-only-tool-token
METRICS_TOKEN=local-development-only-metrics

PRIVACY_NOTICE_VERSION=UNAPPROVED-DEVELOPMENT

# The admin and customer apps talk to the API through this base URL.
API_INTERNAL_URL=http://localhost:4000/v1
