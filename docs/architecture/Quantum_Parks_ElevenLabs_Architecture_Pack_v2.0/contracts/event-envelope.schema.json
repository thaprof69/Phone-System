{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantumparks.example/schemas/event-envelope.schema.json",
  "title": "Domain Event Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id","schema_version","event_type","aggregate_type","aggregate_id","correlation_id","occurred_at","recorded_at","actor","purpose","data_classification","payload"],
  "properties": {
    "event_id": {"type":"string","format":"uuid"},
    "schema_version": {"type":"integer","minimum":1},
    "event_type": {"type":"string","minLength":1},
    "aggregate_type": {"type":"string","minLength":1},
    "aggregate_id": {"type":"string","minLength":1},
    "call_id": {"type":["string","null"]},
    "correlation_id": {"type":"string","minLength":1},
    "causation_id": {"type":["string","null"]},
    "occurred_at": {"type":"string","format":"date-time"},
    "recorded_at": {"type":"string","format":"date-time"},
    "actor": {"type":"object","additionalProperties":false,"required":["type"],"properties":{"type":{"enum":["USER","SYSTEM","PROVIDER","WORKFLOW"]},"id":{"type":["string","null"]}}},
    "purpose": {"type":"string","minLength":1},
    "data_classification": {"enum":["PUBLIC","INTERNAL","CONFIDENTIAL","RESTRICTED"]},
    "payload": {"type":"object"}
  }
}
