NODE_ENV=development
QP_ENVIRONMENT=development
DATABASE_URL=postgresql://quantum_parks:quantum_parks@localhost:5432/quantum_parks
REDIS_URL=redis://localhost:6379
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-west-1
S3_BUCKET_RAW=qp-raw-evidence
S3_BUCKET_ASSETS=qp-assets
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio-secret
OIDC_ISSUER=http://localhost:8080/realms/quantum-parks
OIDC_CLIENT_ID=quantum-parks-admin
OIDC_AUDIENCE=quantum-parks-api
OIDC_CLIENT_SECRET_REF=local/keycloak/quantum-parks-admin
ELEVENLABS_BASE_URL=http://localhost:4100
ELEVENLABS_SANDBOX_BASE_URL=http://localhost:4100
ELEVENLABS_SECRET_REF=local/elevenlabs/api-key
ELEVENLABS_WEBHOOK_SECRET_REF=local/elevenlabs/webhook-secret
ELEVENLABS_WORKSPACE_ID=workspace_synthetic
ELEVENLABS_CAPABILITY_MODE=simulator
# Production: inject exactly one 32-byte base64 master key or a mounted file path.
PROVIDER_CREDENTIAL_MASTER_KEY=
PROVIDER_CREDENTIAL_MASTER_KEY_FILE=
PROVIDER_CREDENTIAL_KEY_VERSION=v1
# AI providers, models, routes, prompts, and budgets are managed in Administration → AI Intelligence.
# Only the extraction-ready internal transport remains deployment configuration.
AIOS_INTERNAL_URL=http://localhost:4000
AIOS_SERVICE_TOKEN=
TWILIO_ACCOUNT_SECRET_REF=local/twilio/account
TWILIO_WEBHOOK_SECRET_REF=local/twilio/webhook
AUDIO_INGESTION_ENABLED=false
CUSTOM_VOICE_ENABLED=false
BOOKING_WRITES_ENABLED=false
PRODUCTION_RETENTION_APPROVED=false
PROVIDER_PRIVACY_APPROVED=false
CALLER_DISCLOSURE_APPROVED=false
NATIVE_LANGUAGE_APPROVALS=
LOCAL_ELEVENLABS_API_KEY=synthetic-api-key
LOCAL_ELEVENLABS_WEBHOOK_SECRET=synthetic-webhook-secret
LOCAL_TOOL_TOKEN=synthetic-tool-token
PRIVACY_NOTICE_VERSION=UNAPPROVED-DEVELOPMENT
