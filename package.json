{
  "name": "quantum-parks-elevenlabs-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "turbo run lint && pnpm architecture:check",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "architecture:check": "tsx scripts/architecture-check.ts",
    "traceability:check": "tsx scripts/traceability-check.ts",
    "check": "pnpm format && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:generate": "pnpm --filter @quantum-parks/db generate",
    "db:migrate": "pnpm --filter @quantum-parks/db migrate",
    "compose:up": "docker compose up -d --build",
    "compose:down": "docker compose down",
    "seed": "pnpm --filter @quantum-parks/db seed"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.1",
    "@types/node": "26.1.1",
    "@typescript-eslint/parser": "8.65.0",
    "eslint": "10.0.1",
    "fast-check": "4.9.0",
    "prettier": "3.9.6",
    "tsx": "4.23.1",
    "turbo": "2.10.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
